{
  "name": "trinh-sua-pdf",
  "productName": "Trình sửa PDF",
  "version": "2.0.0",
  "description": "Bộ công cụ PDF offline cho Windows: 13 công cụ (ghép, tách, tổ chức, crop, số trang, watermark, chuyển đổi, bảo mật) và trình sửa PDF.",
  "author": "Nguyễn Thanh Hưng",
  "main": "main.js",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/HexDino/PDF_edit.git"
  },
  "homepage": "https://github.com/HexDino/PDF_edit#readme",
  "scripts": {
    "start": "electron .",
    "fetch:qpdf": "node scripts/fetch-qpdf.mjs",
    "test:tools": "node --test \"test/suite-unit/*.test.mjs\"",
    "test:suite": "node test/suite-e2e.mjs",
    "prebuild": "npm run fetch:qpdf",
    "build": "electron-builder --win --x64",
    "dist": "npm run build",
    "test": "node test/smoke.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:overlay": "node test/overlay.mjs",
    "test:signature": "node test/signature.mjs",
    "test:erase": "node test/erase.mjs",
    "test:editing": "node test/editing.mjs",
    "test:session": "node test/session.mjs",
    "test:rotation": "node test/rotation.mjs",
    "test:fonts": "node test/fonts-coverage.mjs && node test/fonts-export.mjs",
    "fonts:fetch": "node test/fonts-fetch.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.0"
  },
  "build": {
    "appId": "vn.nguyenthanhhung.trinhsuapdf",
    "productName": "Trình sửa PDF",
    "executableName": "TrinhSuaPDF",
    "copyright": "© 2026 Nguyễn Thanh Hưng",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "suite/**/*",
      "renderer/**/*",
      "build/icon.png",
      "THIRD-PARTY-NOTICES.txt",
      "licenses/**/*",
      "!test/**",
      "!dist/**"
    ],
    "extraResources": [
      { "from": "bin", "to": "bin" }
    ],
    "asar": true,
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF",
          "description": "Tài liệu PDF",
          "role": "Editor"
        }
      ]
    },
    "portable": {
      "artifactName": "TrinhSuaPDF-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "TrinhSuaPDF-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Trình sửa PDF",
      "uninstallDisplayName": "Trình sửa PDF",
      "createDesktopShortcut": true,
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ],
      "language": "1066"
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "^1.17.1"
  }
}
